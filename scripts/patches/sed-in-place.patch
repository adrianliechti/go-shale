 #[allow(clippy::cognitive_complexity)]
+/// GNU sed only accepts an in-place backup suffix attached to `-i`, so a
+/// separate following argument is the script, never a suffix. Rewrite
+/// `-iSUFFIX` to `-i=SUFFIX`; together with `require_equals` this keeps clap
+/// from consuming the next argument after a bare `-i`.
+fn gnu_in_place_args(args: impl Iterator<Item = OsString>) -> Vec<OsString> {
+    let mut options_done = false;
+    args.map(|arg| {
+        if options_done {
+            return arg;
+        }
+        match arg.to_str() {
+            Some("--") => {
+                options_done = true;
+                arg
+            }
+            Some(s) if s.len() > 2 && s.starts_with("-i") && !s.starts_with("-i=") => {
+                OsString::from(format!("-i={}", &s[2..]))
+            }
+            _ => arg,
+        }
+    })
+    .collect()
+}
